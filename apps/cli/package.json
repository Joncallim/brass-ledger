{
  "name": "@brass-ledger/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "brass-ledger": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/workspace-files.mjs clean dist && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node --import tsx src/index.ts",
    "run": "node dist/index.js",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@brass-ledger/content": "*",
    "@brass-ledger/headless": "*",
    "@brass-ledger/save-store": "*",
    "@brass-ledger/shared": "*",
    "@brass-ledger/sim": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
